{
  "name": "claude-for-discord",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "deploy": "wrangler deploy",
    "dev": "wrangler dev",
    "format": "biome format --write",
    "knip": "knip",
    "lint": "biome check",
    "lint:fix": "biome check --write",
    "prepare": "husky",
    "register": "bun run scripts/register-commands.ts",
    "tail": "wrangler tail",
    "typecheck": "wrangler types --include-env=false --check && tsc --noEmit && tsc --noEmit -p scripts/tsconfig.json && tsc --noEmit -p tests/tsconfig.json",
    "types": "wrangler types --include-env=false",
    "verify": "bun run lint && bun run typecheck && bun run knip && bun test"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@types/bun": "^1.4.2",
    "@types/node": "^26.6.4",
    "husky": "^9.1.7",
    "knip": "^6.40.0",
    "lint-staged": "^17.6.0",
    "typescript": "^7.0.2",
    "wrangler": "^4.148.0"
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ],
    "rules": {
      "type-enum": [
        2,
        "always",
        [
          "feat",
          "fix",
          "docs",
          "style",
          "refactor",
          "perf",
          "test",
          "ci",
          "chore",
          "release",
          "revert"
        ]
      ],
      "subject-case": [
        0
      ]
    }
  },
  "lint-staged": {
    "*.{ts,json}": "biome check --write --no-errors-on-unmatched"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.132.1"
  }
}
