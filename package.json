{
  "name": "claude-for-discord",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "wrangler types --include-env=false --check && tsc --noEmit && tsc --noEmit -p scripts/tsconfig.json",
    "lint": "biome check",
    "lint:fix": "biome check --write",
    "format": "biome format --write",
    "verify": "bun run lint && bun run typecheck && bun test",
    "register": "bun run scripts/register-commands.ts",
    "tail": "wrangler tail",
    "types": "wrangler types --include-env=false"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@types/node": "^26.6.4",
    "typescript": "^7.0.2",
    "wrangler": "^4.148.0"
  }
}
